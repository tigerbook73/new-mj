{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "env": ["PORT", "VITE_PORT", "VITE_SERVER_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {},
    "test:full": {},
    "test:e2e": {
      "env": ["E2E_SERVER_PORT", "E2E_WEB_PORT", "E2E_WORKERS"]
    },
    "test:e2e:full": {
      "env": ["E2E_SERVER_PORT", "E2E_WEB_PORT", "E2E_WORKERS"]
    },
    "format": {},
    "format:check": {}
  }
}
