{
  "name": "new-mj",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "worktree-cli run turbo run dev",
    "build": "turbo run build",
    "format": "git ls-files -z | xargs -0 prettier --ignore-unknown --log-level warn --write",
    "format:check": "git ls-files -z | xargs -0 prettier --ignore-unknown --check",
    "typecheck": "turbo run typecheck && tsc -p tools/tsconfig.json",
    "lint": "turbo run lint && eslint tools",
    "lint:fix": "eslint --fix .",
    "test": "turbo run test && node --test tools/*.test.ts",
    "test:full": "turbo run test:full && node --test tools/*.test.ts",
    "test:e2e": "worktree-cli run turbo run test:e2e",
    "test:e2e:full": "worktree-cli run turbo run test:e2e:full",
    "verify": "pnpm format && pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm test:e2e",
    "verify:full": "pnpm format && pnpm typecheck && pnpm lint && pnpm build && pnpm test:full && pnpm test:e2e:full",
    "check:deps": "node tools/check-deps.ts",
    "cli:junk:play": "node packages/core/src/rulesets/junk/cli.ts play",
    "fuzz:junk": "node packages/core/src/rulesets/junk/cli.ts fuzz",
    "tune:junk": "node packages/ai/src/junk/tune-cli.ts",
    "compare:junk-weights": "node packages/ai/src/junk/compare-weights-cli.ts",
    "decision-diff:junk": "node packages/ai/src/junk/decision-diff-cli.ts",
    "calibrate:junk": "node packages/ai/src/junk/calibration/cli-entry.ts",
    "snapshot:junk-ai": "node packages/ai/src/junk/snapshot-junk-cli-entry.ts",
    "sb:start": "supabase start",
    "sb:stop": "supabase stop",
    "sb:restart": "supabase stop && supabase start",
    "sb:status": "supabase status",
    "worktree:new": "worktree-cli create",
    "worktree:status": "worktree-cli status",
    "worktree:doctor": "worktree-cli doctor"
  },
  "devDependencies": {
    "@new-mj/devtools": "workspace:*",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.46",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.5",
    "supabase": "^2.109.1",
    "tsup": "^8.5.1",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
